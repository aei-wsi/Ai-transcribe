# --- Transcription (speech-to-text) ---
# "assemblyai" for real transcription, "mock" to run the full pipeline without any API keys (dev/demo)
STT_PROVIDER=mock
ASSEMBLYAI_API_KEY=

# --- Enrichment (summary, key quotes, auto-tagging) ---
# If unset, the app falls back to a simple heuristic summary (no LLM call).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- YouTube connector (pull in your saved videos automatically) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/connectors/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: a dedicated playlist to poll (e.g. a playlist you named "Transcribe").
# NOTE: YouTube's API does NOT expose the built-in Watch Later playlist, so use
# Liked videos (synced by default) or a dedicated playlist.
YOUTUBE_PLAYLIST_ID=

# --- Media download ---
# Extra args passed to yt-dlp, e.g. --cookies-from-browser chrome for age-restricted
# or login-required content (Instagram/TikTok often need this).
YTDLP_EXTRA_ARGS=

# Base URL of the app (used for OAuth redirects)
APP_URL=http://localhost:3000
